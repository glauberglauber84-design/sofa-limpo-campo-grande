---
import { siteConfig, montarLinkWhatsApp } from '../config/siteConfig';
const linkWa = montarLinkWhatsApp();
---

<header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200">
  <div class="max-w-content mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 group min-h-[44px]">
      <span aria-hidden="true" class="inline-flex items-center justify-center w-11 h-11 rounded-md bg-primaria-escura text-white font-bold text-lg shadow-card group-hover:bg-primaria transition-colors">
        SL
      </span>
      <span class="flex flex-col leading-tight">
        <span class="font-bold text-primaria-escura text-base sm:text-lg">
          {siteConfig.nome}
        </span>
        <span aria-hidden="true" class="text-xs text-slate-600 hidden sm:block">
          {siteConfig.horario}
        </span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-700" aria-label="Menu principal">
      <a href="/" class="flex items-center py-2 min-h-[44px] hover:text-primaria-escura transition-colors">Início</a>
      <a href="/sobre/" class="flex items-center py-2 min-h-[44px] hover:text-primaria-escura transition-colors">Sobre</a>
      <a href="/servicos/" class="flex items-center py-2 min-h-[44px] hover:text-primaria-escura transition-colors">Serviços</a>
      <a href="/conteudo/" class="flex items-center py-2 min-h-[44px] hover:text-primaria-escura transition-colors">Conteúdo</a>
      <a href="/contato/" class="flex items-center py-2 min-h-[44px] hover:text-primaria-escura transition-colors">Contato</a>
    </nav>

    <a
      href={linkWa}
      target="_blank"
      rel="noopener"
      class="hidden sm:inline-flex items-center gap-2 bg-whatsapp hover:bg-whatsappEscuro text-white font-semibold px-5 py-3 rounded-sm text-sm transition-colors shadow-card min-h-[44px]"
      aria-label={`Chamar no WhatsApp ${siteConfig.whatsappDisplay}`}
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.52 3.48A11.78 11.78 0 0012.03 0C5.48 0 .17 5.31.17 11.86a11.73 11.73 0 001.59 5.92L0 24l6.4-1.68a11.86 11.86 0 005.63 1.44h.01c6.55 0 11.86-5.31 11.86-11.86a11.78 11.78 0 00-3.38-8.42zM12.04 21.78h-.01a9.9 9.9 0 01-5.04-1.38l-.36-.21-3.8 1 1.02-3.7-.24-.38a9.9 9.9 0 1118.33-5.25c0 5.47-4.44 9.92-9.9 9.92z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <a
      href={linkWa}
      target="_blank"
      rel="noopener"
      class="sm:hidden inline-flex items-center gap-2 bg-whatsapp text-white font-bold px-4 py-3 rounded-sm text-sm transition-colors min-h-[44px]"
      aria-label="Chamar no WhatsApp"
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.52 3.48A11.78 11.78 0 0012.03 0C5.48 0 .17 5.31.17 11.86a11.73 11.73 0 001.59 5.92L0 24l6.4-1.68a11.86 11.86 0 005.63 1.44h.01c6.55 0 11.86-5.31 11.86-11.86a11.78 11.78 0 00-3.38-8.42z"/>
      </svg>
      Chamar
    </a>
  </div>
</header>
