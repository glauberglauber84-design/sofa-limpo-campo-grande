---
export interface FaqItem {
  pergunta: string;
  resposta: string;
}

export interface Props {
  faq: FaqItem[];
  titulo?: string;
}

const { faq, titulo = 'Perguntas frequentes' } = Astro.props;
---

{faq.length > 0 && (
  <section class="bg-white">
    <div class="max-w-content mx-auto px-4 py-12 sm:py-16">
      <header class="max-w-2xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-primaria-escura mb-2">
          {titulo}
        </h2>
        <p class="text-slate-700">
          Tirando dúvidas comuns antes mesmo de você chamar.
        </p>
      </header>

      <div class="space-y-3 max-w-3xl">
        {faq.map((item, idx) => (
          <details
            class="group bg-bgsuave rounded-md border border-slate-200 open:border-primaria/40 open:shadow-card transition-shadow"
            open={idx === 0}
          >
            <summary class="cursor-pointer list-none p-4 font-semibold text-primaria-escura flex items-start justify-between gap-3">
              <span>{item.pergunta}</span>
              <span
                class="shrink-0 inline-flex w-6 h-6 items-center justify-center rounded-sm bg-primaria text-white text-sm font-bold transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="px-4 pb-4 text-slate-700 text-sm leading-relaxed">
              {item.resposta}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
