---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, montarLinkWhatsApp } from '../config/siteConfig';

const linkWa = montarLinkWhatsApp();
---

<BaseLayout
  title="Pedido recebido! Em breve respondemos"
  description="Recebemos seu pedido de orçamento. Nossa equipe responde em até 30 minutos no horário comercial."
  noindex={true}
>
  <section class="bg-bgsuave min-h-[70vh] flex items-center">
    <div class="max-w-content mx-auto px-4 py-16 text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-whatsapp text-white text-3xl font-bold mb-6 shadow-cardHover">
        ✓
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-primaria-escura mb-3">
        Pedido recebido!
      </h1>
      <p class="text-slate-700 max-w-xl mx-auto mb-8">
        Nossa equipe vai analisar sua mensagem e responder em até 30 minutos no
        horário comercial ({siteConfig.horario}). Se preferir falar agora
        mesmo, clique no botão abaixo.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={linkWa}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 bg-whatsapp hover:bg-whatsappEscuro text-white font-bold px-6 py-3 rounded-sm text-base shadow-card transition-colors"
        >
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.52 3.48A11.78 11.78 0 0012.03 0C5.48 0 .17 5.31.17 11.86a11.73 11.73 0 001.59 5.92L0 24l6.4-1.68a11.86 11.86 0 005.63 1.44h.01c6.55 0 11.86-5.31 11.86-11.86a11.78 11.78 0 00-3.38-8.42z"/>
          </svg>
          Falar no WhatsApp agora
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 bg-primaria hover:bg-primaria-escura text-white font-semibold px-6 py-3 rounded-sm text-base transition-colors"
        >
          Voltar à página inicial
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
